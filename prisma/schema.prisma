generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agencies {
  id                       String                    @id
  name                     String
  email                    String                    @unique
  ownerId                  String                    @unique
  commissionPercentage     Float                     @default(15)
  isVerified               Boolean                   @default(false)
  bankDetails              Json?
  payoutSchedule           String                    @default("monthly")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime
  users                    users                     @relation(fields: [ownerId], references: [id])
  api_keys                 api_keys[]
  bookings                 bookings[]
  experiences              experiences[]
  invoices                 invoices[]
  notification_preferences notification_preferences?
  team_members             team_members[]
}

model api_keys {
  id        String   @id
  agencyId  String
  key       String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  agencies  agencies @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model audit_logs {
  id         String   @id
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())
  users      users    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}

model bookings {
  id                   String         @id
  bookingNumber        String         @unique
  experienceId         String
  agencyId             String
  selectedDate         DateTime
  numberOfParticipants Int
  subtotal             Float
  discount             Float          @default(0)
  taxes                Float          @default(0)
  total                Float
  participantName      String
  participantEmail     String
  specialRequests      String?
  status               booking_status @default(PENDING)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime
  userId               String
  agencies             agencies       @relation(fields: [agencyId], references: [id])
  experiences          experiences    @relation(fields: [experienceId], references: [id])
  users                users          @relation(fields: [userId], references: [id])
  invoices             invoices?
  payments             payments?

  @@index([agencyId])
  @@index([experienceId])
  @@index([selectedDate])
  @@index([status])
  @@index([userId])
}

model experiences {
  id              String            @id
  title           String
  slug            String            @unique
  description     String
  destination     String
  category        String
  coverImage      String
  images          String[]
  basePrice       Float
  minGroupSize    Int               @default(1)
  maxGroupSize    Int               @default(20)
  difficultyLevel difficulty_level  @default(MODERATE)
  agencyId        String
  status          experience_status @default(DRAFT)
  averageRating   Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  bookings        bookings[]
  agencies        agencies          @relation(fields: [agencyId], references: [id])
  reviews         reviews[]

  @@index([agencyId])
  @@index([category])
  @@index([destination])
  @@index([status])
}

model invoices {
  id            String         @id
  invoiceNumber String         @unique
  bookingId     String         @unique
  agencyId      String
  subtotal      Float
  taxAmount     Float
  total         Float
  status        invoice_status @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  agencies      agencies       @relation(fields: [agencyId], references: [id])
  bookings      bookings       @relation(fields: [bookingId], references: [id])

  @@index([agencyId])
  @@index([createdAt])
  @@index([status])
}

model notification_preferences {
  id              String           @id
  agencyId        String           @unique
  emailOnBooking  Boolean          @default(true)
  emailOnPayment  Boolean          @default(true)
  digestFrequency digest_frequency @default(WEEKLY)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  agencies        agencies         @relation(fields: [agencyId], references: [id])
}

model payments {
  id                    String         @id
  bookingId             String         @unique
  amount                Float
  currency              String         @default("USD")
  status                payment_status @default(PENDING)
  method                payment_method
  stripePaymentIntentId String?
  razorpayOrderId       String?
  razorpayPaymentId     String?
  razorpaySignature     String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime
  bookings              bookings       @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([method])
  @@index([status])
}

model reviews {
  id           String        @id
  experienceId String
  rating       Int
  title        String?
  content      String?
  isVerified   Boolean       @default(false)
  status       review_status @default(PENDING)
  createdAt    DateTime      @default(now())
  experiences  experiences   @relation(fields: [experienceId], references: [id])

  @@index([experienceId])
  @@index([status])
}

model team_members {
  id          String   @id
  userId      String
  agencyId    String
  role        String
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  agencies    agencies @relation(fields: [agencyId], references: [id])
  users       users    @relation(fields: [userId], references: [id])

  @@index([agencyId])
  @@index([userId])
}

model users {
  id                     String         @id
  email                  String         @unique
  passwordHash           String
  firstName              String
  lastName               String
  role                   user_role      @default(CUSTOMER)
  emailVerified          Boolean        @default(false)
  avatarUrl              String?
  emailVerificationToken String?
  passwordResetToken     String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime
  agencies               agencies?
  audit_logs             audit_logs[]
  bookings               bookings[]
  team_members           team_members[]
}

enum booking_status {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum difficulty_level {
  EASY
  MODERATE
  HARD
  EXPERT
}

enum digest_frequency {
  WEEKLY
  MONTHLY
  NEVER
}

enum experience_status {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum invoice_status {
  DRAFT
  SENT
  PAID
}

enum payment_method {
  STRIPE
  RAZORPAY
}

enum payment_status {
  PENDING
  COMPLETED
  FAILED
}

enum review_status {
  PENDING
  APPROVED
}

enum user_role {
  ADMIN
  AGENCY
  CUSTOMER
}
